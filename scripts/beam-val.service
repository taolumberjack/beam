[Unit]
Description=BEAM Subnet 105 Validator
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/beam
Environment=PYTHONPATH=/root/beam
Environment=PATH=/opt/beam-venv/bin
ExecStart=/opt/beam-venv/bin/python neurons/validator/core/validator.py \
    --wallet.name taoLumberjackBeamVal \
    --wallet.hotkey va1 \
    --netuid 105 \
    --subtensor.network finney \
    --logging.debug
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
